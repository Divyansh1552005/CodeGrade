# The backend API's base URL.
#
# Local dev: leave empty (or delete the line) — the Vite dev server proxies
# "/api" to the backend on PORT (see vite.config.js), so the default
# baseURL ("/api") in api/client.js already works without setting anything.
#
# Production build (e.g. deploying to Vercel): set this to your deployed
# backend's full origin — no trailing slash, no "/api" suffix — e.g.
# https://codegrade-api.onrender.com
VITE_API_URL=
