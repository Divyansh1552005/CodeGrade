{
  "name": "code-grading-portal-server",
  "version": "1.0.0",
  "description": "AI-Powered Code Grading & Doubt Resolution Portal — backend",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "cross-env NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --runInBand --detectOpenHandles",
    "seed": "node scripts/seed.js",
    "worker": "node worker.js",
    "test:smoke": "node scripts/smokeJobs.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "transform": {},
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  },
  "dependencies": {
    "@langchain/core": "^1.2.17",
    "@langchain/google-genai": "^2.3.2",
    "@langchain/groq": "^1.3.1",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^6.34.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^10.1.3",
    "supertest": "^7.0.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
