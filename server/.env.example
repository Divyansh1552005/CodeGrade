MONGODB_URI=your-mongodb-connection-string

# Redis — required by all BullMQ workers; also backs rate limiting.
# API jobs are durably accepted into MongoDB during Redis outages.
# Worker needs Redis persistence and maxmemory-policy=noeviction.
# Copy the current connection URL from your Redis provider dashboard.
# Tests mock the grading queue and use an in-memory limiter.
REDIS_URL=redis://default:password@host:port

# JWT secrets (use two DIFFERENT long random strings)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# LLM provider selection: "gemini" (default) or "groq"
LLM_PROVIDER=gemini

# Google Gemini (used when LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-2.5-flash          # a current "flash" tier model from Google AI Studio

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile     # a current Groq-hosted model that supports tool calling

# Judge0 CE via RapidAPI — keep the key secret, regenerate if ever exposed
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-x-rapidapi-key

PORT=5000

# Set to "production" on a real deployment (Render, etc). Controls the
# refresh-token cookie's Secure/SameSite flags (see utils/cookies.js) —
# required for the cross-site Vercel<->Render setup to work at all.
# NODE_ENV=production

# Split-origin deployments (e.g. Vercel frontend + Render backend): the
# frontend origin(s) allowed for credentialed CORS, so the httpOnly refresh
# cookie is accepted. Comma-separated, `*` wildcard supported. REQUIRED in
# production — see app.js. Not needed for local dev (Vite proxy makes
# requests same-origin).
# CLIENT_ORIGIN=https://your-app.vercel.app,https://*.vercel.app

# Optional namespace isolation for parallel environments/tests. Leave unset
# in normal use. All workers sharing a MongoDB must use the same QUEUE_PREFIX.
# QUEUE_PREFIX=bull
# RATE_LIMIT_PREFIX=codegrade-dev

# --- AI doubt triage and hint chat (see docs/ai-doubts-hints.md) ---
# Both features are OFF unless set to true. With triage off, POST /doubts behaves as before.
FEATURE_AI_TRIAGE=false
FEATURE_HINT_CHAT=false
# Optional tuning (defaults shown). All limits use the Asia/Kolkata day.
# TRIAGE_REJECT_THRESHOLD=0.85
# TRIAGE_TIMEOUT_MS=15000
# TRIAGE_STUCK_MINUTES=5
# MAX_DOUBTS_PER_DAY=10
# HINT_MAX_MESSAGES_PER_DAY=10
# HINT_MAX_MESSAGES_PER_WINDOW=2
# HINT_WINDOW_SECONDS=60
# REFUND_CAP_PER_DAY=3
# AI_MAX_CONCURRENT_CALLS=4   # per process, not cluster-wide
# LOG_LEVEL=info

# --- Email: account verification and password reset (see the "Email" section of README.md) ---
# Both features are OFF unless set to true. With both off, signup and login behave as they always have.
# Run `node scripts/migrateEmailVerified.js` BEFORE turning FEATURE_EMAIL_VERIFICATION on, or the
# login check still treats accounts with no emailVerified value as verified, but run it anyway.
FEATURE_EMAIL_VERIFICATION=false
FEATURE_PASSWORD_RESET=false
# Required in the API AND the worker whenever a flag is on. The two values must be identical: the worker
# rebuilds each link from this secret. At least 32 characters, for example `openssl rand -base64 48`.
# Changing it invalidates links that have not been used yet.
EMAIL_TOKEN_SECRET=change-me-to-a-long-random-string-of-at-least-32-characters
# The frontend origin used in every email link (never taken from a request header). https in production.
APP_BASE_URL=http://localhost:5173
# Brevo (transactional email API). Without BREVO_API_KEY outside production nothing is sent: the worker logs the recipient
# (masked), the subject and the link instead. In production a missing key stops the process at startup.
# BREVO_API_KEY=xkeysib-your-key
# MAIL_FROM="CodeGrade <no-reply@your-domain.com>"   # a sender verified in Brevo
# Optional tuning (defaults shown).
# EMAIL_VERIFY_TTL_HOURS=24
# PASSWORD_RESET_TTL_MINUTES=30
# EMAIL_RESEND_COOLDOWN_SECONDS=60     # per account, enforced silently
# EMAIL_RESEND_HOURLY_CAP=5            # per account, per IP and per email address
# UNVERIFIED_TTL_DAYS=7                # unverified signups older than this are deleted
# AUTH_RESPONSE_FLOOR_MS=300           # minimum response time of forgot-password and resend-verification
# EMAIL_SEND_TIMEOUT_MS=10000

# --- Admin account and teacher access (see the "Teacher access" section of README.md) ---
# The admin is the ONE account named here. It is created or updated at API startup, verified, with role admin.
# ADMIN_EMAIL is only a login name: the app never sends mail to it. Log in at /admin/login.
# Whoever can read this file can log in as admin: never commit .env, and keep it out of logs and screenshots.
# Unset ADMIN_EMAIL = no admin is managed (an existing admin is left alone, with a warning).
# Changing ADMIN_EMAIL makes the new address the admin and demotes the old one; changing ADMIN_PASSWORD
# updates the password and ends the admin's sessions. In production the password needs at least 12
# characters and must not be a common word, a sequence, or contain the admin email name.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Hours an admin session lasts. It never extends beyond this, even by refreshing. Default 8.
# ADMIN_SESSION_HOURS=8
# Verified teacher applications waiting for a decision. Past this, new teacher signups are refused (default 200).
# TEACHER_APPLICATION_CAP=200
# Teacher signups from one IP per hour (default 5).
# TEACHER_SIGNUPS_PER_IP_PER_HOUR=5

# Run the queue consumers inside the API process (one free Render service instead of a paid worker).
# Leave unset when a separate `npm run worker` is deployed. Needs the same variables as the worker.
# RUN_WORKER=true
